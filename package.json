{
  "name": "folio-design-system",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.0.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@fortawesome/pro-solid-svg-icons": "^6.0.0",
    "@fortawesome/pro-regular-svg-icons": "^6.0.0",
    "@fortawesome/pro-light-svg-icons": "^6.0.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "playwright": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "design-sync": "node build.mjs && node .design-sync/run-resync.mjs",
    "design-sync:test": "node .design-sync/run-resync.test.mjs",
    "style-guide:sync": "node -e \"const f=require('fs');f.writeFileSync('archive/cube-brand-design-system/glass-ui-style.md',f.readFileSync('.design-sync/style-guide-banner.txt','utf8')+f.readFileSync('brand/glass-ui-style.md','utf8'))\"",
    "style-guide:check": "node -e \"const f=require('fs');const a=f.readFileSync('brand/glass-ui-style.md','utf8');const b=f.readFileSync('archive/cube-brand-design-system/glass-ui-style.md','utf8');const i=b.indexOf('-->');if(b.slice(i+4).trimStart()!==a.trimStart()){console.error('style guide copies differ - run npm run style-guide:sync');process.exit(1)}console.log('style guide copies match')\""
  }
}

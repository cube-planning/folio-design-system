{
  "pkg": "folio-design-system",
  "globalName": "FolioDS",
  "projectId": "778e58da-f7d5-4747-9cca-1d86fbe38777",
  "shape": "package",
  "buildCmd": "node build.mjs",
  "cssEntry": "tokens/tokens.css",
  "tokensGlob": "tokens/typography.css",
  "runtimeFontPrefixes": ["DM Sans", "JetBrains Mono"],
  "componentSrcMap": {
    "Text":         "components/Text.jsx",
    "Avatar":       "components/Avatar.jsx",
    "Button":       "components/Button.jsx",
    "Input":        "components/Input.jsx",
    "Textarea":     "components/Textarea.jsx",
    "Select":       "components/Select.jsx",
    "ListItem":     "components/ListItem.jsx",
    "Badge":        "components/Badge.jsx",
    "Banner":       "components/Banner.jsx",
    "Drawer":       "components/Drawer.jsx",
    "SegmentedButton": "components/SegmentedButton.jsx",
    "Toggle":       "components/Toggle.jsx",
    "Table":        "components/Table.jsx",
    "SourceCard":   "components/SourceCard.jsx",
    "Cell":         "components/TableCells.jsx",
    "ImportDrawer": "components/ImportDrawer.jsx",
    "Stepper":      "components/Stepper.jsx",
    "TaskCard":     "components/TaskCard.jsx"
  },
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "Drawer": {"cardMode": "single", "primaryStory": "DrawerShell"},
    "ImportDrawer": {"cardMode": "single", "primaryStory": "JustworksImport"},
    "SourceCard": {"cardMode": "column"},
    "Stepper": {"cardMode": "column"},
    "Table": {"cardMode": "column"}
  }
}

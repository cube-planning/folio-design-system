    "CubeInput": "components/CubeInput.jsx",
    "CubeSelect": "components/CubeSelect.jsx",
    "CubeBadge": "components/CubeBadge.jsx",
    "CubeBanner": "components/CubeBanner.jsx",
    "CubeDrawer": "components/CubeDrawer.jsx",
    "CubeSegmented": "components/CubeSegmented.jsx",
    "CubeToggle": "components/CubeToggle.jsx",
    "CubeTable": "components/CubeTable.jsx",
    "CubeSourceCard": "components/CubeSourceCard.jsx"
  },
  "overrides": {
    "CubeButton": {"cardMode": "column"},
    "CubeDrawer": {"cardMode": "single", "primaryStory": "DrawerShell"}

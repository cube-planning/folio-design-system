<div style="display:flex;align-items:center;justify-content:center;padding:2rem 0;">
  <div style="position:relative;width:220px;height:220px;">
    <svg width="220" height="220" viewBox="0 0 220 220" style="position:absolute;top:0;left:0;">
      <defs>
        <linearGradient id="cubeGrad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="10%" stop-color="#7A5AF8"/>   <!-- purple-500 -->
          <stop offset="50%" stop-color="#9B8AFB"/>   <!-- purple-400 -->
          <stop offset="100%" stop-color="#6938EF"/>  <!-- purple-600 -->
        </linearGradient>
      </defs>
      <g transform="translate(110,110) scale(1.3128) translate(-110,-110)">
        <path d="M99.64,56.06 Q110,50 120.36,56.06 L148.39,72.44 Q158.75,78.5 158.75,90.5 L158.75,129.5 Q158.75,141.5 148.39,147.56 L120.36,163.94 Q110,170 99.64,163.94 L71.61,147.56 Q61.25,141.5 61.25,129.5 L61.25,90.5 Q61.25,78.5 71.61,72.44 Z" fill="url(#cubeGrad)"/>
      </g>
    </svg>
    <div id="sparkle" style="position:absolute;left:92px;top:92px;width:36px;height:36px;">
      <svg width="36" height="36" viewBox="0 0 18 18" style="position:absolute;left:0;top:0;">
        <path d="M9 0 L11 7 L18 9 L11 11 L9 18 L7 11 L0 9 L7 7 Z" fill="#ffffff" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round"/>
      </svg>
      <svg width="20" height="20" viewBox="0 0 18 18" style="position:absolute;left:34px;top:-6px;">
        <path d="M9 0 L11 7 L18 9 L11 11 L9 18 L7 11 L0 9 L7 7 Z" fill="#ffffff" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round"/>
      </svg>
      <svg width="14" height="14" viewBox="0 0 18 18" style="position:absolute;left:40px;top:22px;">
        <path d="M9 0 L11 7 L18 9 L11 11 L9 18 L7 11 L0 9 L7 7 Z" fill="#ffffff" stroke="#ffffff" stroke-width="1.5" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>
</div>
<script>
(function() {
  var el = document.getElementById('sparkle');
  var radius = 58.5;
  var angle = 45;
  // Respect prefers-reduced-motion (glass-ui-style.md 2): park the sparkle
  // at its start position instead of orbiting.
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var r0 = angle * Math.PI / 180;
    el.style.transform = 'translate(' + (Math.cos(r0) * radius).toFixed(1) + 'px, ' +
                                        (Math.sin(r0) * radius).toFixed(1) + 'px)';
    return;
  }
  function tick() {
    angle = (angle + 0.4) % 360;
    var rad = angle * Math.PI / 180;
    var x = Math.cos(rad) * radius;
    var y = Math.sin(rad) * radius;
    el.style.transform = 'translate(' + x.toFixed(1) + 'px, ' + y.toFixed(1) + 'px)';
    requestAnimationFrame(tick);
  }
  requestAnimationFrame(tick);
})();
</script>